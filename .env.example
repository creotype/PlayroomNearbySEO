# Google Sheets runtime identity. Share the spreadsheet with this service account.
GOOGLE_SPREADSHEET_ID=10QigScXswOt9QUns059V5PWqc29aOul74UwNoUGSeAM
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json
# Alternative for platforms without secret mounts: one-line JSON or base64 JSON.
# GOOGLE_SERVICE_ACCOUNT_JSON=

TELEGRAM_BOT_TOKEN=
# Numeric review-group ID configured by the technical administrator.
TELEGRAM_REVIEW_CHAT_ID=

GHOST_ADMIN_URL=https://beaver.run.place/internal
GHOST_ADMIN_API_KEY=
GHOST_API_VERSION=v5.0

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# One landscape hero per article, generated before the review card is created.
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=high
# Mount this path on durable storage in Docker to avoid paid regeneration after restarts.
HERO_IMAGE_CACHE_DIR=/app/data/hero-images

# Master server-side switch for the Monday/Friday editorial loop.
EDITORIAL_AUTOMATION_ENABLED=false
EDITORIAL_TIME_ZONE=Europe/Belgrade
# Weekdays use 0=Sunday ... 6=Saturday.
EDITORIAL_RUN_DAYS=1,5
EDITORIAL_RUN_TIME=10:00
AUTO_PUBLISH_AFTER_REVIEW=true
REVIEW_DEADLINE_HOURS=48
PUBLICATION_TIME=10:00

TARGET_ENVIRONMENT=staging
PORT=8080
LOG_LEVEL=info
POLL_INTERVAL_MS=15000
DRY_RUN=true
ALLOW_GHOST_PUBLISH=false
ALLOW_TELEGRAM_GENERATION=false

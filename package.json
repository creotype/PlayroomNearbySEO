{
  "name": "playroom-nearby-seo-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx --env-file-if-exists=.env.local src/index.ts",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "googleapis": "176.0.0",
    "grammy": "1.45.1",
    "jose": "6.2.9",
    "marked": "18.0.10",
    "openai": "7.5.0",
    "pino": "10.3.1",
    "sanitize-html": "2.17.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/sanitize-html": "2.16.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
